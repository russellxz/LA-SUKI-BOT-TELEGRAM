# ─────────────────────────────────────────────────────────────
#  LA SUKI BOT — TELEGRAM
#  Copia este archivo como .env o pon estas variables en el
#  panel de tu hosting (en Pterodactyl: pestaña "Startup").
# ─────────────────────────────────────────────────────────────

# 🔑 OBLIGATORIO: el token que te da @BotFather
BOT_TOKEN=123456789:AAEejemplo_de_token_de_botfather

# 👑 Tu ID de Telegram (te lo dice @userinfobot).
#    Puedes poner varios separados por coma.
#    Si lo dejas vacío, al arrancar la consola te dará un código
#    para reclamar el bot con: .soyowner <código>
OWNER_ID=

# 🌐 Servidor de las APIs de descarga (déjalo así si no tienes uno propio)
# API_BASE=https://api-sky.ultraplus.click
# API_KEY=Russellxz
# NEOXR_KEY=russellxz

# 🖥️ Solo si montaste tu propio servidor de la Bot API de Telegram
#    (permite subir archivos de hasta 2 GB en vez de 50 MB)
# TELEGRAM_API_URL=http://127.0.0.1:8081
